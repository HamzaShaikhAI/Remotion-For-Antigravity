{
  "name": "antigravity-remotion-skills",
  "version": "2.4.0",
  "description": "Remotion Engine for Antigravity (REA) - Autonomous video motion graphics skills, plugins, sound synthesis, and CLI for Google Antigravity 2.0",
  "main": "bin/rea-cli.js",
  "bin": {
    "rea": "./bin/rea-cli.js"
  },
  "files": [
    "bin",
    "src",
    ".gemini/config/skills/remotion-dastras",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "scripts": {
    "postinstall": "node ./bin/rea-cli.js install-skill",
    "test": "node bin/rea-cli.js --help",
    "rea": "node bin/rea-cli.js",
    "list-plugins": "node bin/rea-cli.js list-plugins",
    "batch-test": "node scripts/overnight-batch-test.ts"
  },
  "keywords": [
    "antigravity",
    "antigravity-agent",
    "remotion",
    "motion-graphics",
    "video-generation",
    "ai-agent",
    "rea",
    "dastras",
    "vox-editorial",
    "sfx-synthesis"
  ],
  "author": "Hamza Shaikh",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/lambda": "^4.0.543",
    "@remotion/media-utils": "^4.0.543",
    "@remotion/zod-types": "^4.0.543",
    "axios": "^1.21.1",
    "edge-tts-universal": "^1.4.0",
    "ffmpeg-static": "^5.3.0",
    "fs-extra": "^11.4.1",
    "googleapis": "^190.0.0",
    "playwright": "^1.65.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "typescript": "^5.0.0"
  }
}
